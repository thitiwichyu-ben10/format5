{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quotation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "quotation_number",
    "quotation_date",
    "customer",
    "items"
  ],
  "properties": {
    "quotation_number": {
      "type": "string",
      "minLength": 1
    },
    "quotation_date": {
      "type": "string",
      "minLength": 1
    },
    "valid_until": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "address": {
          "type": "string"
        },
        "tax_id": {
          "type": "string"
        },
        "contact": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string"
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "quantity",
          "unit",
          "unit_price"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unit": {
            "type": "string"
          },
          "unit_price": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "discount": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "vat_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 7
    },
    "vat_included": {
      "type": "boolean",
      "default": false
    },
    "payment_terms": {
      "type": "string"
    },
    "delivery_terms": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "enum": [
        "THB"
      ],
      "default": "THB"
    }
  }
}